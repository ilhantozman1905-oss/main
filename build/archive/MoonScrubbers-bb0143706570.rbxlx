        <Item class="Folder" referent="15">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="16">
            <Properties>
              <string name="Name">CleaningController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Cleaning = {}

function Cleaning.start(config, root, input, viewmodel, ui, effects)
    local player = Players.LocalPlayer
    local c = config.Cleaning
    local remotes = root:WaitForChild("Remotes")
    local floor = workspace:WaitForChild("MoonScrubbersPrototype"):WaitForChild("CleanSurface")
    local surface = Instance.new("SurfaceGui")
    surface.Name, surface.Face, surface.Adornee = "LocalDustGrid", Enum.NormalId.Top, floor
    surface.CanvasSize = Vector2.new(c.Columns * 32, c.Rows * 32)
    surface.LightInfluence, surface.AlwaysOnTop = 1, false
    surface.Parent = player:WaitForChild("PlayerGui")
    local frames = {}
    for row = 1, c.Rows do
        for column = 1, c.Columns do
            local id = (row - 1) * c.Columns + column
            local frame = Instance.new("Frame")
            frame.Size = UDim2.fromScale(1 / c.Columns, 1 / c.Rows)
            frame.Position = UDim2.fromScale((column - 1) / c.Columns, (row - 1) / c.Rows)
            frame.BorderSizePixel = 0
            frame.BackgroundColor3 = Color3.fromRGB(166, 151, 123)
            frame.Parent = surface
            frames[id] = frame
        end
    end
    local function apply(cells, progress)
        for id, remaining in pairs(cells) do
            if frames[id] then frames[id].BackgroundTransparency = 1 - remaining / c.DustPerCell end
        end
        ui:setProgress(progress)
    end
    -- Connect before requesting a snapshot; buffer deltas while the request is in flight.
    local ready, queued, revision = false, {}, -1
    remotes.CellsChanged.OnClientEvent:Connect(function(cells, progress, incomingRevision)
        if not ready then table.insert(queued, {cells, progress, incomingRevision}); return end
        if incomingRevision <= revision then return end
        revision = incomingRevision
        apply(cells, progress)
    end)
    local snapshot = remotes.Snapshot:InvokeServer()
    assert(snapshot, "Initial dust snapshot unavailable")
    revision = snapshot.revision
    apply(snapshot.cells, snapshot.progress)
    for _, delta in ipairs(queued) do
        if delta[3] > revision then
            revision = delta[3]
            apply(delta[1], delta[2])
        end
    end
    ready = true
    remotes.Collected.OnClientEvent:Connect(function(position) effects:collected(position) end)

    local equipped, previousMode, previousMin, previousMax = false, nil, nil, nil
    local function setEquipped(enabled)
        if equipped == enabled then return end
        equipped = enabled
        if enabled then
            previousMode = player.CameraMode
            previousMin, previousMax = player.CameraMinZoomDistance, player.CameraMaxZoomDistance
            player.CameraMode = Enum.CameraMode.LockFirstPerson
            player.CameraMinZoomDistance, player.CameraMaxZoomDistance = 0.5, 0.5
        else
            player.CameraMode = previousMode or Enum.CameraMode.Classic
            player.CameraMaxZoomDistance = previousMax or 128
            player.CameraMinZoomDistance = previousMin or 0.5
        end
        input:setEnabled(enabled)
        ui.enabled = enabled
        ui:update()
    end
    local characterConnections = {}
    local function onCharacter(character)
        setEquipped(false)
        for _, connection in ipairs(characterConnections) do connection:Disconnect() end
        characterConnections = {}
        local function refresh()
            local tool = character:FindFirstChild("LSD Toothbrush")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            setEquipped(tool ~= nil and humanoid ~= nil and humanoid.Health > 0)
        end
        table.insert(characterConnections, character.ChildAdded:Connect(refresh))
        table.insert(characterConnections, character.ChildRemoved:Connect(refresh))
        local humanoid = character:WaitForChild("Humanoid")
        table.insert(characterConnections, humanoid.Died:Connect(function() setEquipped(false) end))
        refresh()
    end
    player.CharacterAdded:Connect(onCharacter)
    player.CharacterRemoving:Connect(function() setEquipped(false) end)
    if player.Character then task.spawn(onCharacter, player.Character) end
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Include
    rayParams.FilterDescendantsInstances = {floor}
    local lastSent = 0
    RunService:BindToRenderStep("MoonBrush", Enum.RenderPriority.Camera.Value + 1, function()
        local camera = workspace.CurrentCamera
        if not camera then return end
        local active = equipped and input.held
        viewmodel:update(camera, equipped, active, os.clock())
        effects:update(active)
        if not active or os.clock() - lastSent < 1 / c.RequestsPerSecond then return end
        lastSent = os.clock()
        local size = camera.ViewportSize
        local ray = camera:ViewportPointToRay(size.X / 2, size.Y / 2)
        local hit = workspace:Raycast(ray.Origin, ray.Direction * c.MaxReach, rayParams)
        if hit then remotes.Scrub:FireServer(hit.Position) end
    end)
end

return Cleaning
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="17">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Effects = {}

function Effects.new(config)
    local sound = Instance.new("Sound")
    sound.Name = "MoonBrushing"
    sound.SoundId = config.Audio.BrushSoundId
    sound.Volume, sound.Looped = 0.25, true
    sound.Parent = workspace.CurrentCamera
    local self = {lastCollection = -math.huge}
    function self:collected(position)
        self.lastCollection = os.clock()
        if sound.SoundId ~= "" and not sound.IsPlaying then sound:Play() end
        local bead = Instance.new("Part")
        bead.Name, bead.Shape = "LocalDust", Enum.PartType.Ball
        bead.Size = Vector3.new(0.12, 0.12, 0.12)
        bead.Anchored = true
        bead.CanCollide, bead.CanTouch, bead.CanQuery = false, false, false
        bead.Color = Color3.fromRGB(219, 195, 149)
        bead.Position, bead.Parent = position + Vector3.new(0, 0.1, 0), workspace
        local emitter = Instance.new("ParticleEmitter")
        emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
        emitter.Color = ColorSequence.new(bead.Color)
        emitter.Rate = 0
        emitter.Lifetime = NumberRange.new(0.2, 0.4)
        emitter.Speed = NumberRange.new(0.5, 1.5)
        emitter.SpreadAngle = Vector2.new(60, 60)
        emitter.Size = NumberSequence.new(0.18)
        emitter.Parent = bead
        emitter:Emit(4)
        local character = Players.LocalPlayer.Character
        local tank = character and character:FindFirstChild("DustTank")
        if tank then
            TweenService:Create(bead, TweenInfo.new(0.35), {Position = tank.Position, Transparency = 1}):Play()
        end
        Debris:AddItem(bead, 0.5)
    end
    function self:update(active)
        if not active or os.clock() - self.lastCollection > 0.25 then sound:Stop() end
    end
    return self
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="18">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--!strict
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Input = {}

function Input.new()
    local self = {held = false, enabled = false}
    UserInputService.WindowFocusReleased:Connect(function() self.held = false end)
    GuiService.MenuOpened:Connect(function() self.held = false end)
    function self:setEnabled(enabled)
        self.enabled, self.held = enabled, false
        ContextActionService:UnbindAction("MoonScrub")
        if not enabled then return end
        ContextActionService:BindAction("MoonScrub", function(_, state)
            self.held = state == Enum.UserInputState.Begin or state == Enum.UserInputState.Change
            return Enum.ContextActionResult.Sink
        end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
        ContextActionService:SetTitle("MoonScrub", "POETS")
        ContextActionService:SetPosition("MoonScrub", UDim2.fromScale(0.78, 0.55))
    end
    return self
end

return Input
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="19">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local UI = {}

function UI.new()
    local player = Players.LocalPlayer
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset = "MoonHUD", false, false
    gui.Parent = player:WaitForChild("PlayerGui")
    local function label(name, position, size, text)
        local item = Instance.new("TextLabel")
        item.Name, item.Position, item.Size = name, position, size
        item.BackgroundColor3 = Color3.fromRGB(21, 28, 42)
        item.BackgroundTransparency = 0.15
        item.TextColor3 = Color3.fromRGB(237, 241, 245)
        item.Font = Enum.Font.GothamBold
        item.TextSize, item.TextWrapped = 16, true
        item.Text, item.Parent = text, gui
        return item
    end
    local tank = label("Tank", UDim2.fromScale(0.03, 0.03), UDim2.fromScale(0.4, 0.065), "")
    local progress = label("Progress", UDim2.fromScale(0.57, 0.03), UDim2.fromScale(0.4, 0.065), "Zone: 0% schoon")
    local help = label("Help", UDim2.fromScale(0.1, 0.78), UDim2.fromScale(0.8, 0.12), "")
    local crosshair = label("Crosshair", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(12, 12), "+")
    crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
    crosshair.BackgroundTransparency = 1
    local bar = Instance.new("Frame")
    bar.Size, bar.Position = UDim2.fromScale(0, 0.006), UDim2.fromScale(0.03, 0.097)
    bar.BackgroundColor3 = Color3.fromRGB(214, 185, 126)
    bar.BorderSizePixel, bar.Parent = 0, gui
    local self = {enabled = false}
    function self:update()
        local dust = player:GetAttribute("Dust") or 0
        local capacity = player:GetAttribute("TankCapacity") or 50
        tank.Text = string.format("STOFTANK  %.1f / %d", dust, capacity)
        bar.Size = UDim2.fromScale(0.4 * math.clamp(dust / capacity, 0, 1), 0.006)
        crosshair.Visible = self.enabled
        if dust >= capacity - 0.001 then
            help.Text = "Tank vol! Verkopen volgt in stap 4. Herstart de testsessie om opnieuw te testen."
        elseif self.enabled then
            help.Text = "Kijk omlaag. Houd muis / R2 / POETS vast en beweeg het richtpunt over het stof."
        else
            help.Text = "Rust je LSD Toothbrush uit om te poetsen."
        end
    end
    function self:setProgress(value)
        progress.Text = string.format("ZONE  %.1f%% schoon", value * 100)
    end
    player:GetAttributeChangedSignal("Dust"):Connect(function() self:update() end)
    player:GetAttributeChangedSignal("TankCapacity"):Connect(function() self:update() end)
    self:update()
    return self
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="20">
            <Properties>
              <string name="Name">ViewmodelController</string>
              <string name="Source"><![CDATA[--!strict
local Viewmodel = {}

function Viewmodel.new()
    local model = Instance.new("Model")
    model.Name = "MoonToothbrushViewmodel"
    local parts = {}
    local function part(name, size, color, offset)
        local item = Instance.new("Part")
        item.Name, item.Size, item.Color = name, size, color
        item.Anchored = true
        item.CanCollide, item.CanTouch, item.CanQuery, item.CastShadow = false, false, false, false
        item.Parent = model
        table.insert(parts, {part = item, offset = offset})
    end
    part("Glove", Vector3.new(0.32, 0.38, 0.5), Color3.fromRGB(228, 231, 232), CFrame.new(0, -0.12, 0))
    part("Handle", Vector3.new(0.11, 0.1, 1.05), Color3.fromRGB(72, 184, 193), CFrame.new(0, 0, -0.38))
    part("BrushHead", Vector3.new(0.24, 0.1, 0.35), Color3.fromRGB(72, 184, 193), CFrame.new(0, 0, -1))
    part("Bristles", Vector3.new(0.21, 0.13, 0.3), Color3.fromRGB(242, 239, 211), CFrame.new(0, 0.1, -1))
    local self = {model = model}
    function self:update(camera, enabled, held, time)
        model.Parent = enabled and camera or nil
        if not enabled then return end
        local stroke = held and math.sin(time * 24) or 0
        local pose = camera.CFrame * CFrame.new(0.55 + stroke * 0.12, -0.48, -0.85)
            * CFrame.Angles(math.rad(-12), math.rad(-15 + stroke * 8), math.rad(-12))
        for _, item in ipairs(parts) do item.part.CFrame = pose * item.offset end
    end
    return self
end

return Viewmodel
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
