          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local root = ReplicatedStorage:WaitForChild("MoonScrubbers")
local Config = require(root.Shared.Config)

local remotesFolder = Instance.new("Folder")
remotesFolder.Name = "Remotes"
remotesFolder.Parent = root
local remotes = {}
for name, class in pairs({Scrub = "RemoteEvent", Collected = "RemoteEvent", CellsChanged = "RemoteEvent", Snapshot = "RemoteFunction"}) do
    local remote = Instance.new(class)
    remote.Name, remote.Parent = name, remotesFolder
    remotes[name] = remote
end

-- Isolated prototype geometry; never clears an existing map or changes gravity.
assert(not workspace:FindFirstChild("MoonScrubbersPrototype"), "Prototype already exists")
local world = Instance.new("Folder")
world.Name, world.Parent = "MoonScrubbersPrototype", workspace
local floor = Instance.new("Part")
floor.Name = "CleanSurface"
floor.Anchored = true
floor.Size = Vector3.new(Config.Cleaning.Columns * Config.Cleaning.CellSize, 1, Config.Cleaning.Rows * Config.Cleaning.CellSize)
floor.Position = Vector3.new(0, Config.World.FloorY - 0.5, 0)
floor.Material = Enum.Material.Slate
floor.Color = Color3.fromRGB(82, 91, 108)
floor.Parent = world
local spawn = Instance.new("SpawnLocation")
spawn.Name = "MoonSpawn"
spawn.Size = Vector3.new(4, 1, 4)
spawn.Anchored, spawn.CanCollide, spawn.CanQuery = true, false, false
spawn.Transparency = 1
spawn.Position = Vector3.new(0, Config.World.SpawnHeight, 0)
spawn.Neutral, spawn.Duration = true, 0
spawn.Parent = world

require(script.Parent.Services.PlayerStateService).start(Config)
require(script.Parent.Services.CleaningService).start(Config, floor, remotes)
root:SetAttribute("Ready", true)
print("[Moon Scrubbers] Step 2 ready: equip toothbrush, look down, hold and sweep")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">CleaningService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Grid = require(ReplicatedStorage.MoonScrubbers.Shared.Grid)
local Service = {}

function Service.start(config, floor, remotes)
    local c = config.Cleaning
    local cells, pending, sessions = {}, {}, {}
    local totalCollected, revision = 0, 0
    for id = 1, c.Columns * c.Rows do cells[id] = c.DustPerCell end
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Include
    rayParams.FilterDescendantsInstances = {floor}

    remotes.Snapshot.OnServerInvoke = function(player)
        local now = os.clock()
        local session = sessions[player] or {}
        sessions[player] = session
        if session.snapshotAt and now - session.snapshotAt < 1 then return nil end
        session.snapshotAt = now
        return {cells = table.clone(cells), progress = totalCollected / (c.Columns * c.Rows * c.DustPerCell), revision = revision}
    end

    remotes.Scrub.OnServerEvent:Connect(function(player, target)
        local now = os.clock()
        local session = sessions[player] or {}
        sessions[player] = session
        -- Rate limit before any raycasts or collection work, including invalid requests.
        if session.requestAt and now - session.requestAt < 0.9 / c.RequestsPerSecond then return end
        session.requestAt = now
        if typeof(target) ~= "Vector3" or not Grid.finiteVector(target.X, target.Y, target.Z) then return end
        local character = player.Character
        local head = character and character:FindFirstChild("Head")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local tool = character and character:FindFirstChild("LSD Toothbrush")
        if not head or not humanoid or humanoid.Health <= 0 or not tool or not tool:GetAttribute("MoonTool") then return end
        local direction = target - head.Position
        if direction.Magnitude < 0.01 or direction.Magnitude > c.MaxReach then return end
        -- Check actual line of sight: characters and scenery can obstruct the floor.
        local visibility = RaycastParams.new()
        visibility.FilterType = Enum.RaycastFilterType.Exclude
        visibility.FilterDescendantsInstances = {character}
        local visibleHit = workspace:Raycast(head.Position, direction.Unit * (direction.Magnitude + 0.2), visibility)
        if not visibleHit or visibleHit.Instance ~= floor then return end
        local hit = workspace:Raycast(head.Position, direction.Unit * (direction.Magnitude + 0.2), rayParams)
        if not hit or (hit.Position - target).Magnitude > 0.5 or hit.Normal.Y < 0.9 then return end
        local localPoint = floor.CFrame:PointToObjectSpace(hit.Position)
        if not Grid.cellAt(localPoint.X, localPoint.Z, c.CellSize, c.Columns, c.Rows) then return end
        local previous, previousAt = session.target, session.validAt
        session.target, session.validAt = target, now
        -- Holding still does not farm dust. Real aim/movement drives the brush strokes.
        if not previous or now - previousAt > 0.5 then return end
        local distance = (target - previous).Magnitude
        if distance < c.MinStrokeDistance or distance > c.MaxStrokeDistance then return end
        local tank = player:GetAttribute("Dust") or 0
        local capacity = player:GetAttribute("TankCapacity") or config.StartingStats.TankCapacity
        local ids = Grid.cellsWithin(localPoint.X, localPoint.Z, c.BrushRadius, c.CellSize, c.Columns, c.Rows)
        local budget = c.DustPerSecond * math.min(now - previousAt, 0.2)
        local amount, changes = Grid.collect(cells, ids, budget, tank, capacity)
        if amount <= 0 then return end
        player:SetAttribute("Dust", math.min(capacity, tank + amount))
        totalCollected = totalCollected + amount
        revision = revision + 1
        for id, remaining in pairs(changes) do pending[id] = remaining end
        remotes.Collected:FireClient(player, hit.Position, amount)
    end)

    Players.PlayerRemoving:Connect(function(player) sessions[player] = nil end)
    task.spawn(function()
        while floor.Parent do
            task.wait(c.ReplicationInterval)
            if next(pending) then
                remotes.CellsChanged:FireAllClients(pending, totalCollected / (c.Columns * c.Rows * c.DustPerCell), revision)
                pending = {}
            end
        end
    end)
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">PlayerStateService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local State = {}

function State.start(config)
    local function characterAdded(player, character)
        local humanoid = character:WaitForChild("Humanoid", 10)
        local backpack = player:WaitForChild("Backpack", 10)
        if not humanoid or not backpack or not player.Parent then return end
        local tool = Instance.new("Tool")
        tool.Name = "LSD Toothbrush"
        tool.RequiresHandle = false
        tool.CanBeDropped = false
        tool:SetAttribute("MoonTool", true)
        tool.Parent = backpack
        humanoid:EquipTool(tool)

        local pack = Instance.new("Part")
        pack.Name = "DustTank"
        pack.Size = Vector3.new(1.4, 1.8, 0.7)
        pack.Color = Color3.fromRGB(65, 74, 90)
        pack.Massless = true
        pack.CanCollide, pack.CanTouch, pack.CanQuery = false, false, false
        local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        if not torso then pack:Destroy(); return end
        pack.CFrame = torso.CFrame * CFrame.new(0, 0, 0.85)
        pack.Parent = character
        local weld = Instance.new("WeldConstraint")
        weld.Part0, weld.Part1, weld.Parent = torso, pack, pack
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Back
        gui.CanvasSize = Vector2.new(140, 180)
        gui.Parent = pack
        local background = Instance.new("Frame")
        background.Size = UDim2.fromScale(0.7, 0.8)
        background.Position = UDim2.fromScale(0.15, 0.1)
        background.BackgroundColor3 = Color3.fromRGB(25, 30, 40)
        background.Parent = gui
        local fill = Instance.new("Frame")
        fill.Name = "Fill"
        fill.AnchorPoint = Vector2.new(0, 1)
        fill.Position = UDim2.fromScale(0, 1)
        fill.BackgroundColor3 = Color3.fromRGB(210, 181, 123)
        fill.Parent = background
        -- Only the server updates tank quantities and the replicated backpack gauge.
        local function update()
            local ratio = player:GetAttribute("Dust") / player:GetAttribute("TankCapacity")
            fill.Size = UDim2.fromScale(1, math.clamp(ratio, 0, 1))
        end
        update()
        local connection = player:GetAttributeChangedSignal("Dust"):Connect(update)
        pack.Destroying:Once(function() connection:Disconnect() end)
    end
    local function added(player)
        player:SetAttribute("Dust", 0)
        player:SetAttribute("TankCapacity", config.StartingStats.TankCapacity)
        player.CharacterAdded:Connect(function(character) characterAdded(player, character) end)
        if player.Character then task.spawn(characterAdded, player, player.Character) end
    end
    Players.PlayerAdded:Connect(added)
    for _, player in ipairs(Players:GetPlayers()) do added(player) end
end

return State
]]></string>
